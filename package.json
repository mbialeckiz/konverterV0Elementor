{
  "name": "react-to-elementor-converter",
  "version": "1.0.0",
  "description": "Convert React/TypeScript V0 projects to Elementor JSON templates",
  "main": "dist/index.js",
  "bin": {
    "react-to-elementor": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "convert": "npm run build && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "react",
    "elementor",
    "wordpress",
    "converter",
    "v0",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "axios": "^1.6.7",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "htmlparser2": "^9.1.0",
    "node-fetch": "^2.7.0",
    "prettier": "^3.2.5",
    "chalk": "^4.1.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
